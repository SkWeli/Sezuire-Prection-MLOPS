# This patient is invalid because the recording session
# does NOT have eeg:hasSamplingRate.
eeg:patient_bad01 a eeg:Patient ;
    eeg:subjectID "bad01" ;
    eeg:hasSession eeg:session_bad01 .

eeg:session_bad01 a eeg:RecordingSession ;
    eeg:sessionID "bad01_session" ;
    eeg:hasChannel eeg:channel_bad01_1 ;
